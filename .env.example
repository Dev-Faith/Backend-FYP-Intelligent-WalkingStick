NODE_ENV=development
PORT=3000
# Neon pooled connection string (hostname normally contains `-pooler`).
DATABASE_URL=postgresql://USER:PASSWORD@EP-NAME-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Neon direct connection string, used by Prisma migrations.
DIRECT_URL=postgresql://USER:PASSWORD@EP-NAME.REGION.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=wakatech-api
JWT_AUDIENCE=wakatech-mobile
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
DEVICE_INGEST_KEY=replace-with-a-local-development-device-key
# Unique development credential provisioned into the seeded stick.
SEEDED_DEVICE_SECRET=replace-with-a-different-seeded-device-secret
# Presentation-only: permits repeated claims of a valid seeded demo device.
# Keep false for real production devices.
DEMO_DEVICE_CLAIMING=false
MQTT_URL=mqtt://localhost:1883
REDIS_URL=redis://localhost:6379
# Optional enhanced Expo push-security token.
EXPO_ACCESS_TOKEN=
EXPO_RECEIPT_DELAY_MS=900000
OUTBOX_POLL_MS=2000
ONLINE_AFTER_SECONDS=120
STALE_AFTER_SECONDS=600
